generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// The connection URL lives in prisma.config.ts / lib/prisma.ts (Prisma 7 style).
datasource db {
  provider = "sqlite"
}

model Profile {
  id                Int     @id
  name              String
  role              String
  location          String
  available         Boolean @default(true)
  summary           String
  yearsExperience   String
  profileImage      String
  productsShipped   String
  performanceMetric String
  lighthouse        String
  usersImpacted     String
  socialLinks       String
  /// Hiring snapshot (shown on the homepage when filled in)
  targetRoles       String  @default("")
  workPreference    String  @default("")
  availability      String  @default("")
  noticePeriod      String  @default("")
  /// Extra facts only the "Ask my resume" assistant uses (education, languages, certifications…)
  assistantNotes    String  @default("")
}

model SiteCopy {
  id      Int    @id
  content String
}

model SkillGroup {
  id    Int    @id @default(autoincrement())
  name  String @unique
  items String
  order Int    @unique
}

model Experience {
  id      Int     @id @default(autoincrement())
  role    String
  company String
  period  String
  current Boolean @default(false)
  bullets String
  order   Int     @unique
}

model Project {
  id           Int     @id @default(autoincrement())
  slug         String  @unique
  title        String
  description  String
  stack        String
  featured     Boolean @default(false)
  /// "case-study" (page with sections), "article" (long-form page) or "link" (card opens externalUrl)
  type         String  @default("case-study")
  image        String  @default("")
  liveUrl      String  @default("")
  repoUrl      String  @default("")
  externalUrl  String  @default("")
  objective    String  @default("")
  approach     String  @default("")
  architecture String  @default("")
  result       String  @default("")
  content      String  @default("")
  /// false = draft: hidden from the site, sitemap and assistant; admins can still preview it
  published    Boolean @default(true)
}

// Uploaded project images, one per project, keyed by the project's slug.
model ProjectImage {
  slug       String @id
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedAt String
}

// Single row (id = 1). Stored in the database so uploads work on Vercel.

// Single-row table (id = 1) holding the uploaded resume file.
model Resume {
  id         Int    @id
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedAt String
}

// Single-row table (id = 1) holding the uploaded profile picture.
model ProfileImage {
  id         Int    @id
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedAt String
}

// Admin users. Sign-up is not possible: users are created by an existing admin or `npm run admin:create`.
model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  name         String @default("")
  passwordHash String
  /// "admin" (can manage users) or "editor" (content only). Always set explicitly by the code.
  role         String @default("admin")
  /// Incremented on password change: invalidates every existing session/token for this user.
  tokenVersion Int    @default(0)
  createdAt    String
}

// Anonymous activity log for the admin Insights tab. No IPs or personal data are stored.
// type: "resume_download" | "contact_email" | "contact_copy" | "contact_linkedin" | "ask"
model Event {
  id        Int    @id @default(autoincrement())
  type      String
  detail    String @default("")
  createdAt String
}

// AI providers for "Ask my resume". Tried in `order`; the next one is used if one fails.
// kind: "anthropic" | "openai" | "openai-compatible". apiKey is stored encrypted (see lib/ai/crypto.ts).
model AiProvider {
  id          Int     @id @default(autoincrement())
  name        String
  kind        String
  baseUrl     String
  model       String
  keyCipher   String  @default("")
  keyHint     String  @default("")
  enabled     Boolean @default(true)
  order       Int     @default(0)
  /// "" = the provider's default temperature
  temperature String  @default("")
  createdAt   String
}

// Small key/value settings (JSON values), e.g. "assistant".
model Setting {
  key   String @id
  value String
}
