# Copy this file to .env and fill in the values:  cp .env.example .env
# Local development only needs the two REQUIRED values. On Vercel, add them under
# Settings → Environment Variables (Production and Preview).

# ─────────────────────────────── REQUIRED ───────────────────────────────

# Database.
#   Local:      a SQLite file on your computer (created by `npm run db:init`). Edits made in the
#               local admin (localhost:3000/admin) stay in this file; they don't reach the live site.
#   Production: your Turso URL, e.g. libsql://your-db-name.turso.io
#   ⚠ Never put this file: value in Vercel. It would give every deploy a fresh, empty database
#     (the deploy now stops with an error if you do). If you connected Turso through Vercel,
#     don't set DATABASE_URL there at all: TURSO_DATABASE_URL is used automatically.
DATABASE_URL="file:./prisma/dev.db"

# Signs login sessions and encrypts the AI provider keys saved in Admin → AI assistant.
# At least 32 random characters. Use a different value in production than locally.
# If you change it later, everyone is signed out and the AI keys must be entered again.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ─────────────────────────────── PRODUCTION DATABASE ───────────────────────────────

# Turso access token. Needed when DATABASE_URL is a libsql:// URL.
# DATABASE_AUTH_TOKEN=""

# Alternatively, connecting Turso through Vercel's Marketplace creates these two for you;
# they are used when DATABASE_URL / DATABASE_AUTH_TOKEN are not set.
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""

# ─────────────────────────────── FIRST ADMIN (optional) ───────────────────────────────

# On deploy, if the database has no admin yet, this account is created.
# Remove ADMIN_PASSWORD afterwards. Locally you can use `npm run admin:create` instead.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""

# ─────────────────────────────── SITE (optional) ───────────────────────────────

# Public address used for SEO tags, sitemap and share images. Default: https://vinay-bharti.vercel.app
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Google Search Console verification. Add a "URL prefix" property for your site, pick "HTML tag", and paste
# only the content value from <meta name="google-site-verification" content="THIS_PART" />. Redeploy after setting.
# GOOGLE_SITE_VERIFICATION=""

# ─────────────────────────────── "ASK MY RESUME" AI (optional) ───────────────────────────────

# Recommended: add providers (Anthropic, OpenAI, Gemini, Groq…) in Admin → AI assistant instead.
# These are only a fallback, used when no provider is added there.
# ANTHROPIC_API_KEY=""
# ASSISTANT_MODEL="claude-haiku-4-5-20251001"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Default questions per day (all visitors) until you save settings in Admin → AI assistant.
# ASK_DAILY_LIMIT="100"
